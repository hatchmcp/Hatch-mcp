# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Supabase project URL and keys (Settings → API in Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Settings → Database → Connection string)

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# AES-256-GCM key for encrypting tenant secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-char-key-here

# GitHub App (optional — needed for GitHub source ingestion)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Job concurrency cap (how many pipeline jobs run in parallel in this process)
JOB_CONCURRENCY=4

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:3000

# ── Runtime ───────────────────────────────────────────────────────────────────
# PORT=8080
# DATABASE_URL=  (same DB as API)
# ENCRYPTION_KEY=  (same key as API — used to decrypt secrets)
# MCP_DOMAIN=mcp.hatch.dev
# For local dev, set MCP_DOMAIN=mcp.lvh.me (resolves to 127.0.0.1)

  DATABASE_URL=postgresql://postgres:%5BGauravG%40560710%5D@db.xbgyzwbroudqgmonjphu.supabase.co:5432/postgres?sslmode=require